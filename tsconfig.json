{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals"]
  },
  "include": ["supabase/functions/_shared/**/*.ts", "tests/**/*.ts"],
  "exclude": ["supabase/functions/_shared/db.ts"]
}
