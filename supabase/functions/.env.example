# Copy to supabase/functions/.env for `npm run functions:serve`
# Leave GOOGLE_PLACES_API_KEY empty to use the mock venue picker.
GOOGLE_PLACES_API_KEY=
# IANA timezone used for meet windows (single launch region for MVP)
MEETCUTE_TZ=Asia/Kolkata
# Shared secret required by cron-invoked functions in production.
# Leave empty locally to allow manual triggering.
CRON_SECRET=
